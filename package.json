{
  "name": "red-link",
  "version": "1.0.0",
  "private": true,
  "description": "Red Link: blood donation platform (React + Express + MongoDB)",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c red,blue \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run typecheck && npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client/tsconfig.app.json",
    "lint": "oxlint shared/src server/src client/src",
    "test": "vitest run",
    "test:api": "node tests/acceptance/run.mjs api",
    "test:ui": "node tests/acceptance/run.mjs ui",
    "db:seed": "npm run seed -w server",
    "db:reset": "npm run seed -w server",
    "bench": "npm run bench -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
