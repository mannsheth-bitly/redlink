# MongoDB (local replica set; transactions need one, see README)
MONGODB_URI="mongodb://127.0.0.1:27017/redlink?replicaSet=rs0"

# Secret used to sign login cookies. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# API server port (the Vite dev server on 5173 forwards /api here)
PORT=4000

# Show the "Demo accounts" box on the login page
VITE_DEMO_MODE=true

# ---- Optional: email alerts for URGENT/CRITICAL notifications (Gmail example) ----
# Create an App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Base URL used for links inside emails
APP_URL="http://localhost:5173"

# ---- Optional: contact email sent to OpenStreetMap Nominatim (address search) ----
GEOCODER_CONTACT=""
